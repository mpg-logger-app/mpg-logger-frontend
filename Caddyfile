# Caddy, the web server in front of MPG Logger: it serves the React app and forwards /api to the
# Spring Boot backend, all on one HTTPS address. Run by docker-compose.yml in the mpg-logger-backend
# repo (see its HOSTING.md).
#
# SITE_ADDRESS is the app's hostname, e.g. mpg-logger.duckdns.org. Caddy gets and renews the HTTPS
# certificate for it by itself. http://localhost serves plain HTTP, for trying it out locally.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# API calls go to Spring Boot. The browser only sees this address, so the app and the API share
	# one origin and the session cookie (SameSite=Lax, Path=/api) works, the same as Vite's proxy in
	# development. Caddy sends X-Forwarded-Proto, so the backend knows the request was HTTPS.
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv

		# Vite's /assets/* names change with their content, so those can be cached forever. Everything
		# else (index.html, sw.js, icons) is checked again each time, so a deploy shows up straight away.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"

		# Pages like /home and /account are handled by the React app, so every path that isn't a real
		# file gets index.html.
		try_files {path} /index.html
		file_server
	}
}
